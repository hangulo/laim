generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String                @id @default(cuid())
  email         String                @unique
  name          String?
  image         String?
  createdAt     DateTime              @default(now())
  accounts      LinkedGoogleAccount[]
  triageResults TriageResult[]
}

model LinkedGoogleAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  image        String?
  accessToken  String
  refreshToken String?
  expiresAt    Int?
  scope        String?
  tokenType    String?
  idToken      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
}

model TriageResult {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  threadId     String
  historyId    String
  category     String
  summary      String
  urgency      Int      @default(0)
  subject      String   @default("")
  fromHeader   String   @default("")
  date         String   @default("")
  accountEmail String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId, threadId])
}

model EmailTracker {
  id        String      @id @default(cuid())
  accountId String
  threadId  String?
  toAddress String
  subject   String
  createdAt DateTime    @default(now())
  opens     EmailOpen[]

  @@index([accountId, threadId])
}

model EmailOpen {
  id        String       @id @default(cuid())
  trackerId String
  tracker   EmailTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  openedAt  DateTime     @default(now())
  userAgent String?
  ip        String?
}
